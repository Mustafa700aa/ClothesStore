generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================
// 1. ADMIN (Super Admin فقط)
// ======================================
model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // bcrypt hashed
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ======================================
// 2. PRODUCTS & CATALOG
// ======================================
model Product {
  id          String   @id @default(uuid())
  name        String
  nameAr      String?
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  images      String[] // روابط صور المنتج
  isActive    Boolean  @default(true)  // Soft Delete
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    Variant[]
  bundleItems BundleItem[]

  @@index([isActive, sortOrder])
  @@map("products")
}

// ======================================
// 3. VARIANTS (المقاسات / الألوان / SKU)
// ======================================
model Variant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  size      String   @default("ONE_SIZE") // S, M, L, XL, XXL, ONE_SIZE
  sku       String   @unique
  price     Decimal? @db.Decimal(10, 2)   // اختياري، لو null يعتمد basePrice للمنتج
  isActive  Boolean  @default(true)       // Soft Delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory          Inventory?
  orderItems         OrderItem[]
  bundleItemVariants BundleItemVariant[]

  @@unique([productId, size])
  @@index([productId])
  @@index([sku])
  @@map("variants")
}

// ======================================
// 4. INVENTORY & AUDIT LOGS
// ======================================
model Inventory {
  id         String   @id @default(uuid())
  variantId  String   @unique
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int      @default(0)       // الرصيد الفعلي المتاح
  reserved   Int      @default(0)       // رصيد مخصص اختياري
  lowStockAt Int      @default(5)       // حد التنبيه
  updatedAt  DateTime @updatedAt

  logs InventoryLog[]

  @@map("inventories")
}

model InventoryLog {
  id          String          @id @default(uuid())
  inventoryId String
  inventory   Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  change      Int             // مثلاً: -2 عند التأكيد، +2 عند الإلغاء، +50 توريد
  reason      InventoryReason
  referenceId String?         // رقم الطلب أو معرف الحركة
  createdAt   DateTime        @default(now())

  @@index([inventoryId])
  @@index([createdAt])
  @@map("inventory_logs")
}

enum InventoryReason {
  MANUAL_RESTOCK
  ORDER_CONFIRMED   // خصم فعلي عند تأكيد الطلب
  ORDER_CANCELLED   // إرجاع المخزون المخصوم لو تم الإلغاء بعد التأكيد
  ORDER_RETURNED    // إرجاع المخزون عند استلام مرتجع الشحن
  ADJUSTMENT        // تسوية جردية يدوية
}

// ======================================
// 5. BUNDLES ENGINE (محرك الباقات الديناميكي)
// ======================================
model Bundle {
  id          String   @id @default(uuid())
  name        String
  nameAr      String?
  description String?
  image       String?
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)  // Soft Delete
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items      BundleItem[]
  orderItems OrderItem[]

  @@index([isActive, sortOrder])
  @@map("bundles")
}

model BundleItem {
  id        String   @id @default(uuid())
  bundleId  String
  bundle    Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int      @default(1)

  // المقاسات المحددة والمسموح باختيارها داخل هذا العنصر بالباقة
  allowedVariants BundleItemVariant[]

  @@unique([bundleId, productId])
  @@index([bundleId])
  @@map("bundle_items")
}

model BundleItemVariant {
  id           String     @id @default(uuid())
  bundleItemId String
  bundleItem   BundleItem @relation(fields: [bundleItemId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([bundleItemId, variantId])
  @@index([bundleItemId])
  @@map("bundle_item_variants")
}

// ======================================
// 6. SHIPPING ZONES (محافظات مصر الـ 27)
// ======================================
model ShippingZone {
  id            String  @id @default(uuid())
  governorate   String  @unique  // "القاهرة", "الجيزة"
  governorateEn String  @unique  // "Cairo", "Giza"
  shippingCost  Decimal @db.Decimal(10, 2)
  estimatedDays Int     @default(2)
  isActive      Boolean @default(true)

  orders Order[]

  @@map("shipping_zones")
}

// ======================================
// 7. CUSTOMERS (Guest Profiles)
// ======================================
model Customer {
  id        String   @id @default(uuid())
  phone     String   @unique  // المعرّف الأساسي
  altPhone  String?           // هاتف طوارئ بديل
  name      String            // آخر اسم مسجل
  address   String?
  city      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([phone])
  @@map("customers")
}

// ======================================
// 8. ORDERS & ORDER ITEMS
// ======================================
model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique  // ORD-20260922-001
  idempotencyKey String?       @unique  // X-Idempotency-Key
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])

  // لقطة بيانات الشحن وقت الطلب (Snapshot غير قابلة للتغيير)
  shippingName     String
  shippingPhone    String
  shippingAltPhone String?
  shippingAddress  String
  shippingCity     String

  shippingZoneId String
  shippingZone   ShippingZone  @relation(fields: [shippingZoneId], references: [id])

  subtotal     Decimal       @db.Decimal(10, 2)
  shippingCost Decimal       @db.Decimal(10, 2)
  discount     Decimal       @default(0) @db.Decimal(10, 2)
  total        Decimal       @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(COD)
  status        OrderStatus   @default(PENDING)

  // بيانات التتبع والشحن
  trackingNumber String?
  carrierName    String?
  adminNotes     String?
  cancelReason   String?
  returnReason   String?
  shippingLoss   Decimal?      @db.Decimal(10, 2)

  // الطوابع الزمنية لكل انتقال
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  returnedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([orderNumber])
  @@index([idempotencyKey])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id       String   @id @default(uuid())
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  bundleId  String?
  bundle    Bundle?  @relation(fields: [bundleId], references: [id])

  productName String
  variantSize String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?      // Super Admin ID
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
}
