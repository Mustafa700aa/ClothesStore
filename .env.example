# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clothes_store?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-clothes-store-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# CORS
CORS_ORIGIN="http://localhost:5173"

# Admin Initial Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@clothesstore.com"
ADMIN_DEFAULT_PASSWORD="ChangeThisStrongPassword123!"

# Cloudflare R2 Storage (S3-Compatible)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="clothes-store-images"
# Public URL / Custom Domain connected to your R2 bucket (e.g., https://media.yourstore.com or pub-xxx.r2.dev)
R2_PUBLIC_URL="https://images.clothesstore.com"
